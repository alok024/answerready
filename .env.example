# AnswerReady environment variables (names only — no values here).
# Everything runs in mock mode with none of these set, so the app builds and
# the full generate + checkout flow works locally with zero keys.

# --- Text generation (optional; mock template FAQs are used when unset) ---
GROQ_API_KEY=
GROQ_MODEL=
# Optional fallback provider if GROQ_API_KEY is not set:
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Razorpay checkout (optional; mock checkout runs when unset) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Test aliases also accepted by the helper:
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
# Only needed if you wire up the Razorpay webhook:
RAZORPAY_WEBHOOK_SECRET=
